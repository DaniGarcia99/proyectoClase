<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header>
      <nav class="navbar">
        <div class="navbar-logo">
          <a href="/"><strong>2DAW</strong></a>
        </div>
        <ul class="navbar-menu">
          <li><a href="/">Inicio</a></li>
          <li><a href="/sobre">Sobre Nosotros</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>
    </header>
    <style>
      header {
        background: rgba(255,255,255,0.9);
        box-shadow: 0 2px 8px rgba(30,80,75,.04), 0 1.5px 7px -2px #7ed3c1;
        padding: 0;
        margin-bottom: 2rem;
      }
      .navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.1rem 2rem 1.1rem 2rem;
      }
      .navbar-logo a {
        font-size: 1.7em;
        color: #5aa9c8;
        text-decoration: none;
        font-weight: bold;
        letter-spacing: 0.03em;
      }
      .navbar-menu {
        list-style: none;
        display: flex;
        gap: 2rem;
        margin: 0;
        padding: 0;
      }
      .navbar-menu li {
        display: inline;
      }
      .navbar-menu a {
        color: #16332a;
        text-decoration: none;
        font-weight: 500;
        font-size: 1em;
        letter-spacing: 0.01em;
        padding: 0.3em 0.6em;
        border-radius: 3px;
        transition: background 0.18s, color 0.18s;
      }
      .navbar-menu a:hover, .navbar-menu a:focus {
        background: #d8fff0;
        color: #0077a8;
      }
      @media (max-width: 650px) {
        .navbar {
          flex-direction: column;
          gap: 1rem;
        }
        .navbar-menu {
          flex-direction: column;
          gap: 0.7rem;
          width: 100%;
          align-items: flex-start;
        }
      }
    </style>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    <footer>
      <p>&copy; <%= new Date().getFullYear() %>. "2DAW. Todos los derechos reservados."</p>
    </footer>
  </body>
</html>
